<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>朋友對我的動態留言板 - 海洋風格</title>
  
  <!-- 引入 Google Fonts 提升質感 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    /* =========================================================
       1. 全局變數設定 (方便後續修改主題顏色與調整風格)
       ========================================================= */
    :root {
      /* 海洋調色盤 */
      --bg-gradient: linear-gradient(135deg, #0f2027, #203a43, #2c5364); /* 背景深海漸層 */
      --ocean-blue: #00d2ff;       /* 海洋明亮藍 */
      --cyan-glow: #3a7bd5;        /* 亮藍光暈 */
      --wave-light: #3a7bd5;       /* 海浪波紋色 */
      --card-bg: rgba(255, 255, 255, 0.12); /* 卡片半透明玻璃材質 */
      --card-border: rgba(255, 255, 255, 0.25); /* 一般卡片邊框色 */
      
      /* 高亮輪播焦點卡片設定 (特別顯眼) */
      --highlight-border: #00f2fe; /* 輪播焦點卡片邊框色 (螢光藍) */
      --highlight-shadow: 0 0 25px rgba(0, 242, 254, 0.8), 0 0 50px rgba(79, 172, 254, 0.5); /* 強烈發光效果 */
      
      --text-main: #ffffff;        /* 主要文字顏色 */
      --text-sub: #b2ebf2;         /* 次要文字顏色 (淡青色) */
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Noto Sans TC', sans-serif;
      background: var(--bg-gradient);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      padding: 2rem 1rem;
      overflow-x: hidden;
      position: relative;
    }

    /* 背景動態氣泡/波紋氛圍裝飾 */
    body::before {
      content: '';
      position: fixed;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.03) 8%, transparent 8%);
      background-size: 24px 24px;
      z-index: 0;
      pointer-events: none;
    }

    /* 頁面標題區 */
    header {
      text-align: center;
      margin-bottom: 2.5rem;
      position: relative;
      z-index: 1;
    }

    header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #e0f7fa;
      text-shadow: 0 0 12px rgba(0, 210, 255, 0.5);
      margin-bottom: 0.5rem;
    }

    header p {
      color: var(--text-sub);
      font-size: 1.05rem;
    }

    /* 主容器 */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* =========================================================
       2. 酷炫海洋載入動畫 (Loading Animation)
       ========================================================= */
    #loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 300px;
    }

    /* 海洋水波浪載入圈 */
    .loader-wave {
      position: relative;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 3px solid transparent;
      border-top-color: var(--ocean-blue);
      border-bottom-color: #4facfe;
      animation: spin 1.5s linear infinite;
    }

    .loader-wave::before {
      content: '';
      position: absolute;
      top: 6px;
      left: 6px;
      right: 6px;
      bottom: 6px;
      border-radius: 50%;
      border: 3px solid transparent;
      border-left-color: #00f2fe;
      animation: spin 0.8s linear infinite reverse;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .loading-text {
      margin-top: 1.5rem;
      font-size: 1.2rem;
      letter-spacing: 2px;
      color: var(--text-sub);
      animation: pulse 1.5s infinite ease-in-out;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 1; }
    }

    /* =========================================================
       3. CSS 瀑布流排版 (Masonry Layout)
       ========================================================= */
    .masonry-wall {
      /* 設定欄數：預設大螢幕 3 欄 */
      column-count: 3;
      column-gap: 1.5rem;
      display: none; /* 載入完成前先隱藏 */
    }

    /* 響應式調整欄位數量 */
    @media (max-width: 900px) {
      .masonry-wall {
        column-count: 2; /* 平板顯示 2 欄 */
      }
    }

    @media (max-width: 600px) {
      .masonry-wall {
        column-count: 1; /* 手機顯示 1 欄 */
      }
    }

    /* =========================================================
       4. 留言卡片樣式與動態效果
       ========================================================= */
    .card {
      /* 關鍵：防止卡片被欄位截斷分開 */
      break-inside: avoid;
      margin-bottom: 1.5rem;
      
      background: var(--card-bg);
      backdrop-filter: blur(10px); /* 磨砂玻璃效果 */
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
      
      /* 過渡動畫：保證縮放、發光、模糊變換時順暢自然 */
      transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
      position: relative;
      overflow: hidden;
    }

    /* 卡片頭部資訊 (名字與時間) */
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.8rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 0.5rem;
    }

    .card-name {
      font-size: 1.15rem;
      font-weight: 600;
      color: #e0f7fa;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* 名字旁的貝殼小圖示 */
    .card-name::before {
      content: '🐚';
      font-size: 0.9rem;
    }

    .card-time {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.5);
    }

    /* 留言內容 */
    .card-body {
      font-size: 0.98rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.9);
      word-break: break-word;
      white-space: pre-wrap; /* 保留留言中的換行 */
    }

    /* =========================================================
       5. 輪播特效狀態樣式 (Focus / Unfocus)
       ========================================================= */
       
    /* 被選中的焦點卡片 (高亮、放大) */
    .card.highlight {
      transform: scale(1.05); /* 放大 5% */
      border-color: var(--highlight-border);
      box-shadow: var(--highlight-shadow);
      background: rgba(255, 255, 255, 0.22); /* 背景稍加亮 */
      z-index: 10; /* 確保高亮卡片層級向上 */
      filter: blur(0px) brightness(1.1);
    }

    /* 未被選中的其他卡片 (微暗、微模糊) */
    .card.dimmed {
      opacity: 0.45; /* 降低透明度 */
      filter: blur(1.5px) brightness(0.85); /* 微微模糊與變暗 */
      transform: scale(0.98);
    }
  </style>
</head>
<body>

  <header>
    <h1>🌊 海洋留言板</h1>
    <p>來自朋友們的悄悄話與祝福</p>
  </header>

  <div class="container">
    <!-- 酷炫載入中動畫 -->
    <div id="loading">
      <div class="loader-wave"></div>
      <div class="loading-text">讀取留言中...</div>
    </div>

    <!-- 瀑布流留言牆卡片區 -->
    <div id="masonry-wall" class="masonry-wall"></div>
  </div>

  <script>
    /* =========================================================
       控制參數設定 (可依照需求彈性修改)
       ========================================================= */
    const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vR4g8D5q29aYDt2qOaa6xFI1elCRgp7i2d1Mh9qTNiaFclje7d223zBSlNbQ5n6H1GLvAQSgX-4XVT5/pub?output=csv';
    
    // 💡 輪播切換的時間（毫秒），3000ms = 3 秒
    const CAROUSEL_INTERVAL = 3000;

    let cardsData = [];      // 存放解析後的 CSV 資料
    let cardElements = [];   // 存放生成的 DOM 卡片節點
    let currentIndex = 0;    // 當前高亮的卡片索引
    let carouselTimer = null;// setInterval 定時器

    // DOM 元素 DOM 節點
    const loadingEl = document.getElementById('loading');
    const wallEl = document.getElementById('masonry-wall');

    /* =========================================================
       CSV 解析器 (處理留言內部可能包含雙引號與逗號的情況)
       ========================================================= */
    function parseCSV(text) {
      const lines = [];
      let row = [];
      let inQuotes = false;
      let currentField = '';

      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        const nextChar = text[i + 1];

        if (char === '"') {
          if (inQuotes && nextChar === '"') {
            // 處理轉義的雙引號 ("")
            currentField += '"';
            i++;
          } else {
            // 切換引號狀態
            inQuotes = !inQuotes;
          }
        } else if (char === ',' && !inQuotes) {
          // 遇到逗號且不在引號內，代表一個欄位結束
          row.push(currentField.trim());
          currentField = '';
        } else if ((char === '\r' || char === '\n') && !inQuotes) {
          // 遇到換行且不在引號內，代表一行結束
          if (char === '\r' && nextChar === '\n') {
            i++; // 跳過 \r\n 中的 \n
          }
          row.push(currentField.trim());
          if (row.some(field => field.length > 0)) {
            lines.push(row);
          }
          row = [];
          currentField = '';
        } else {
          currentField += char;
        }
      }

      // 處理最後一個欄位
      if (currentField || row.length > 0) {
        row.push(currentField.trim());
        lines.push(row);
      }

      return lines;
    }

    /* =========================================================
       資料獲取與初次渲染
       ========================================================= */
    async function fetchMessages() {
      try {
        const response = await fetch(CSV_URL);
        if (!response.ok) throw new Error('網路回應不成功');
        
        const csvText = await response.text();
        const parsedRows = parseCSV(csvText);

        // 排除標題列 (Header: 時間戳記, 名字, 悄悄話)，處理實際資料
        const dataRows = parsedRows.slice(1);

        cardsData = dataRows.map(row => ({
          timestamp: row[0] || '未知時間',
          name: row[1] || '熱心朋友',
          message: row[2] || '這是一條空白的留言...'
        }));

        renderCards();
      } catch (error) {
        console.error('讀取 CSV 失敗:', error);
        loadingEl.innerHTML = `
          <div style="color: #ff8a80; text-align: center;">
            <p>🌊 載入留言失敗，請確認網路連線或網址設定。</p>
          </div>
        `;
      }
    }

    /* 動態生成卡片 HTML 並掛載至畫面 */
    function renderCards() {
      // 清空預設內容
      wallEl.innerHTML = '';
      cardElements = [];

      if (cardsData.length === 0) {
        loadingEl.innerHTML = `<p style="color: var(--text-sub);">目前還沒有任何留言喔！</p>`;
        return;
      }

      cardsData.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'card';
        card.dataset.index = index;

        // XSS 簡易防禦 (過渡化 HTML 特殊字元)
        const safeName = escapeHTML(item.name);
        const safeMessage = escapeHTML(item.message);
        const safeTime = escapeHTML(item.timestamp);

        card.innerHTML = `
          <div class="card-header">
            <span class="card-name">${safeName}</span>
            <span class="card-time">${safeTime}</span>
          </div>
          <div class="card-body">${safeMessage}</div>
        `;

        wallEl.appendChild(card);
        cardElements.push(card);
      });

      // 隱藏 Loading 載入動畫，顯示留言牆
      loadingEl.style.display = 'none';
      wallEl.style.display = 'block';

      // 啟動 3 秒輪播焦點動畫
      startCarousel();
    }

    // 簡易防範 XSS 攻擊的轉義函式
    function escapeHTML(str) {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    /* =========================================================
       重點：隨時間輪播特效 (Highlight 焦點切換)
       ========================================================= */
    function highlightCard(indexToHighlight) {
      if (cardElements.length === 0) return;

      cardElements.forEach((card, i) => {
        if (i === indexToHighlight) {
          // 增加亮起放大 Class，移除變暗 Class
          card.classList.add('highlight');
          card.classList.remove('dimmed');
        } else {
          // 增加變暗 Class，移除亮起 Class
          card.classList.add('dimmed');
          card.classList.remove('highlight');
        }
      });
    }

    function startCarousel() {
      if (cardElements.length === 0) return;

      // 剛開始先高亮第一張
      highlightCard(currentIndex);

      // 設定每 3 秒 (CAROUSEL_INTERVAL) 切換一次
      carouselTimer = setInterval(() => {
        currentIndex = (currentIndex + 1) % cardElements.length; // 循環播放
        highlightCard(currentIndex);
      }, CAROUSEL_INTERVAL);
    }

    // 當頁面載入完成後自動執行
    document.addEventListener('DOMContentLoaded', fetchMessages);
  </script>
</body>
</html>
